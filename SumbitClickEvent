Private Sub btnWrite_Click(sender As Object, e As EventArgs) Handles btnWrite.Click
    'Validate the TextBoxes
    If (checkForEmptyTextBoxes()) Then
        MessageBox.Show("Please fix your mistake")
        Exit Sub
    End If
    Dim fw As System.IO.StreamWriter
    fw = My.Computer.FileSystem.OpenTextFileWriter(filePath, True)
    employeeCount += 1
    Dim employeeCountOutput As String = employeeCount.ToString("D4")
    fw.Write("em_" & employeeCountOutput & ",")
    fw.Write(tbFirst.Text & ",")
    fw.Write(tbLast.Text & ",")
    fw.Write(tbPhone.Text & ",")
    fw.Write(tbWage.Text & vbCr)
    fw.Close()
    ClearForm()
    Dim experiment_2() As String = File.ReadAllLines(filePath)
    experiment_2(0) = employeeCount
    File.WriteAllLines(filePath, experiment_2)
End Sub
