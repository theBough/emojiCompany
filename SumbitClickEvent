 Private Sub btnWrite_Click(sender As Object, e As EventArgs) Handles btnWrite.Click
     Dim fw As System.IO.StreamWriter
     fw = My.Computer.FileSystem.OpenTextFileWriter(filePath, True)
     employeeCount += 1
     Dim employeeCountOutput As String = employeeCount.ToString("D4")
     fw.Write("em_" & employeeCountOutput & ", ")
     fw.Write(tbName.Text & ", ")
     fw.Write(tbLast.Text & ", ")
     fw.Write(tbPhone.Text & vbCr)
     fw.Close()
     ClearForm()
 End Sub
